# B2B Prospector - Variables d'environnement
# Copiez ce fichier vers .env et adaptez les valeurs

# ============================================
# APPLICATION
# ============================================
APP_NAME=B2B Prospector
APP_ENV=production
SECRET_KEY=votre-cle-secrete-ultra-secure-changez-moi
DEBUG=false

# ============================================
# BASE DE DONNÉES
# ============================================
DATABASE_URL=postgresql+asyncpg://prospector:prospector_pass@postgres:5432/prospector_db

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# SMTP PLANETHOSTER
# ============================================
SMTP_HOST=ssl0.planethoster.net
SMTP_PORT=465
SMTP_USER=votre-email@votre-domaine.com
SMTP_PASSWORD=votre-mot-de-passe-smtp
SMTP_FROM_EMAIL=noreply@votre-domaine.com
SMTP_FROM_NAME="B2B Prospector"

# ============================================
# SCRAPING (sans clés API)
# ============================================
# INSEE - API publique gratuite
INSEE_API_BASE=https://recherche-entreprises.api.gouv.fr
INSEE_RATE_LIMIT=10  # requêtes par seconde

# BODACC - API publique gratuite
BODACC_API_BASE=https://bodacc-datadila.opendatasoft.com/api/records/1.0/search

# Pappers - scraping (rate limité)
PAPPERS_RATE_LIMIT=5
PAPPERS_USER_AGENT=Mozilla/5.0 (compatible; B2BProspector/1.0; +https://votre-domaine.com/bot)

# Pages Jaunes - scraping
PAGESJAUNES_RATE_LIMIT=2
PAGESJAUNES_DELAY=3  # secondes entre chaque requête

# Google Maps - Playwright
GOOGLE_MAPS_DELAY=5
PLAYWRIGHT_HEADLESS=true

# ============================================
# PLUGINS
# ============================================
PLUGINS_DIR=./plugins
PLUGINS_AUTOLOAD=true

# ============================================
# LOGS
# ============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/prospector.log

# ============================================
# CORS (Frontend)
# ============================================
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,https://votre-domaine.com

# ============================================
# JWT AUTH
# ============================================
JWT_SECRET_KEY=votre-jwt-secret-changez-moi-aussi
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
