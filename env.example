# =================================================================
# B2B Prospector — Variables d'environnement (Phase 1)
# =================================================================
# Génération secrets : openssl rand -base64 48
# =================================================================

# --- Application ---
APP_NAME=B2B Prospector
APP_VERSION=1.1.0
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# --- Sécurité ---
SECRET_KEY=__CHANGE_ME_openssl_rand_base64_48__
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- CORS (URL frontend) ---
CORS_ORIGINS=https://prospect.le-publicitaire.fr,http://localhost:3000

# --- PostgreSQL ---
POSTGRES_USER=prospector
POSTGRES_PASSWORD=__CHANGE_ME_openssl_rand_base64_32__
POSTGRES_DB=prospector
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://prospector:__CHANGE_ME__@db:5432/prospector
DATABASE_URL_SYNC=postgresql://prospector:__CHANGE_ME__@db:5432/prospector

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__CHANGE_ME_openssl_rand_base64_32__
REDIS_URL=redis://:__CHANGE_ME__@redis:6379/0

# --- Plugins ---
PLUGINS_DIR=/app/plugins
PLUGINS_AUTO_DISCOVER=true

# --- Scrapers (sans clé API, via APIs publiques + scraping) ---
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; B2BProspector/1.1; +https://prospect.le-publicitaire.fr/bot)
SCRAPER_TIMEOUT=30
SCRAPER_RATE_LIMIT_PER_MINUTE=20
SCRAPER_CACHE_TTL_HOURS=24
SCRAPER_RETRY_ATTEMPTS=3

# Sources publiques (sans clé)
INSEE_RECHERCHE_API=https://recherche-entreprises.api.gouv.fr/search
BODACC_API=https://bodacc-datadila.opendatasoft.com/api/explore/v2.1/catalog/datasets/annonces-commerciales/records
PAPPERS_BASE_URL=https://www.pappers.fr
PAGES_JAUNES_BASE_URL=https://www.pagesjaunes.fr
GOOGLE_MAPS_BASE_URL=https://www.google.com/maps

# Playwright (Google Maps headless)
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT=20000

# --- SMTP PlanetHoster ---
SMTP_HOST=mail.le-publicitaire.fr
SMTP_PORT=587
SMTP_USER=noreply@le-publicitaire.fr
SMTP_PASSWORD=__CHANGE_ME__
SMTP_FROM_EMAIL=noreply@le-publicitaire.fr
SMTP_FROM_NAME=B2B Prospector
SMTP_USE_TLS=true

# --- Frontend (build-time Vite) ---
VITE_API_URL=/api/v1
VITE_APP_NAME=B2B Prospector
VITE_APP_VERSION=1.1.0

# --- Admin par défaut (créé au seed) ---
ADMIN_EMAIL=admin@le-publicitaire.fr
ADMIN_PASSWORD=__CHANGE_ME_strong_password__
ADMIN_FULL_NAME=Administrateur

# --- Observabilité (optionnel) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
