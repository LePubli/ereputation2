# B2B Prospector - Variables d'environnement pour Coolify
# Copiez ce fichier en .env et adaptez les valeurs
# Générez les secrets avec: openssl rand -base64 32

# ============================================================
# DATABASE (PostgreSQL) - Coolify gère ces variables
# ============================================================
POSTGRES_USER=prospector
POSTGRES_PASSWORD=change_me_strong_password_32_chars_minimum
POSTGRES_DB=prospector_db
DATABASE_URL=postgresql://prospector:change_me_strong_password_32_chars_minimum@db:5432/prospector_db

# ============================================================
# CACHE & QUEUE (Redis) - Coolify gère ces variables
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_redis_password_32_chars
REDIS_URL=redis://:change_me_strong_redis_password_32_chars@redis:6379/0

# ============================================================
# APPLICATION SECURITY
# ============================================================
# Générer avec: openssl rand -base64 48
SECRET_KEY=change_me_super_secret_key_for_jwt_signing_64_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment: development, staging, production
ENVIRONMENT=production
DEBUG=false

# ============================================================
# API CONFIGURATION
# ============================================================
APP_NAME=B2B Prospector
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FILE=logs/prospector.log

# ============================================================
# EXTERNAL API KEYS (Optionnel selon fonctionnalités)
# ============================================================

# INSEE API (Gratuit - https://api.insee.fr)
INSEE_API_KEY=
INSEE_API_SECRET=

# Pappers API (Freemium - https://www.pappers.fr/api)
PAPPERS_API_KEY=

# LLM Local (Ollama - Recommandé pour confidentialité)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_API_URL=http://host.docker.internal:11434
LLM_API_KEY=

# OpenAI API (Alternative cloud - https://platform.openai.com)
OPENAI_API_KEY=

# ============================================================
# EMAIL OUTREACH (Optionnel)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=B2B Prospector

# ============================================================
# FEATURE FLAGS
# ============================================================
# Liste des plugins activés (séparés par des virgules)
# Valeurs possibles: all, ou liste spécifique
ENABLE_PLUGINS=all

# Plugins individuels (pour debug)
PLUGIN_SCRAPER_INSEE_ENABLED=true
PLUGIN_AUDIT_DIGITAL_ENABLED=true
PLUGIN_PAIN_POINT_ENGINE_ENABLED=true
PLUGIN_PIPELINE_KANBAN_ENABLED=true
PLUGIN_SEMANTIC_ANALYZER_ENABLED=true
PLUGIN_PREDICTIVE_SCORER_ENABLED=true
PLUGIN_OUTREACH_MULTICHANNEL_ENABLED=true
PLUGIN_VOICE_ASSISTANT_ENABLED=true
PLUGIN_AB_TESTING_ENABLED=true
PLUGIN_AUTOMATION_ENGINE_ENABLED=true
PLUGIN_COMPLIANCE_GUARD_ENABLED=true

# ============================================================
# RGPD & CONFORMITÉ
# ============================================================
DATA_RETENTION_DAYS=365
ALLOW_B2B_ONLY=true
GDPR_CONSENT_REQUIRED=true

# ============================================================
# RATE LIMITING & PERFORMANCE
# ============================================================
RATE_LIMIT_PER_MINUTE=60
WORKER_CONCURRENCY=4
MAX_UPLOAD_SIZE_MB=50

# ============================================================
# MONITORING (Optionnel)
# ============================================================
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# ============================================================
# COOLIFY SPECIFIC
# ============================================================
# Coolify injecte automatiquement ces variables
# Ne pas modifier sauf déploiement manuel
INTERNAL_PORT=8000
HEALTH_CHECK_PATH=/api/v1/health
