# B2B Prospector - Variables d'environnement
# Copiez ce fichier en .env et adaptez les valeurs

# Application
APP_NAME=B2B Prospector
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Database
DATABASE_URL=sqlite:///./data/prospector.db

# Redis (Event Bus)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# External APIs (optionnel - pour données enrichies)
INSEE_API_KEY=votre_cle_insee
INSEE_API_SECRET=votre_secret_insee
PAPPERS_API_KEY=votre_cle_pappers

# LLM (optionnel - pour formatting uniquement)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_API_URL=http://localhost:11434
LLM_API_KEY=

# Security
SECRET_KEY=change-me-in-production-use-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# RGPD
DATA_RETENTION_DAYS=365
ALLOW_B2B_ONLY=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/prospector.log
