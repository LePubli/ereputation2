--- .gitignore
```
# Build artifacts
frontend/dist/
frontend/build/

# Dependencies
frontend/node_modules/

# Environment
.env
.env.local
.env.*

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Python (if present)
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage
coverage/
htmlcov/
.coverage

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```

